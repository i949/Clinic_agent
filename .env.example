# Local Ollama configuration (no hosted API key required)
OLLAMA_MODEL=llama3.3
OLLAMA_BASE_URL=http://localhost:11434

# Optional paths; relative paths are resolved from the repository root.
CLINIC_DB=clinic_demo.db
DOCTORS_CSV=data/doctors.csv
PATIENTS_CSV=data/patients.csv
APPOINTMENTS_CSV=data/appointments.csv
BILLING_CSV=data/billing.csv
PAYMENTS_CSV=data/payments.csv

